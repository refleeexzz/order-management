# Environment Variables Template
# Copy this file to .env and fill in your values

# Server
SERVER_PORT=8080

# Database (local dev default: PostgreSQL on localhost:5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=order_management
DB_USER=postgres
DB_PASSWORD=postgres123

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits
JWT_EXPIRATION=86400000

# Docker images (production compose)
BACKEND_IMAGE=ghcr.io/your-org/order-management-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/order-management-frontend:latest

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_IMGBB_API_KEY=
